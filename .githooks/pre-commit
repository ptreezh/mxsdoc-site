#!/bin/sh
# MxsDoc-Site pre-commit 门禁：拦截非相对站内链接
#
# 站点同时部署在两处，路径前缀不同：
#   - GitHub Pages 子路径  https://ptreezh.github.io/mxsdoc-site/
#   - 独立域名（自动抓取镜像）https://agent.gofreeteam.com/
# 因此站内链接必须使用相对链接。凡是 href/src/css-url 出现根绝对路径
# （"/x"）或同站绝对 URL（https://ptreezh.github.io/mxsdoc-site/x.html"）
# 即拒绝提交。
#
# 启用:  git config core.hooksPath .githooks   （commit 文件后即可克隆复用）

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1

if ! command -v python >/dev/null 2>&1; then
    echo "!! pre-commit 门禁: 找不到 python，无法校验。跳过。" >&2
    exit 0
fi

python "$root/.githooks/check-root-paths.py" --staged
rc=$?
if [ $rc -ne 0 ]; then
    echo ""
    echo "✋ 提交被门禁拦截：请把上述非相对站内链接改为相对链接后重新 git add + git commit。"
    exit $rc
fi
exit 0